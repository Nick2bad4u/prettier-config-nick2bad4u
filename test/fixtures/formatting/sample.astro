---
const title = "Sample";
const showDetails = true;
---

<section>
    <!-- Keep the heading and conditional details together. -->
    <h1>{title}</h1>
    {showDetails && (
        <p>
            Read <strong>{title}</strong> details.
        </p>
    )}
</section>

<style>
    section {
        color: rebeccapurple;
    }
</style>
